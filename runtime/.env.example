# Sahara Runtime 环境变量 (所有变量前缀 SAHARA_)
# 复制此文件为 .env 并填入实际值

# gRPC
SAHARA_GRPC_PORT=50051

# 并发
SAHARA_MAX_CONCURRENT_TASKS=8

# Redis
SAHARA_REDIS_URL=redis://localhost:6379

# PostgreSQL
SAHARA_POSTGRES_DSN=postgresql://sahara:sahara_dev@localhost:5432/sahara

# LLM API Keys
SAHARA_ANTHROPIC_API_KEY=sk-ant-xxx
SAHARA_OPENAI_API_KEY=sk-xxx
SAHARA_DEFAULT_MODEL=claude-sonnet-4-20250514

# 沙箱
SAHARA_SANDBOX_ENABLED=true
SAHARA_SANDBOX_POOL_SIZE=4

# 日志
SAHARA_LOG_LEVEL=INFO
SAHARA_LOG_FORMAT=json
